generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  role         String // TEACHER | STUDENT
  passwordHash String? // scrypt hash — set on signup/first claim
  deviceId     String? // device binding (one device per student)
  createdAt    DateTime @default(now())

  teaching    Class[]      @relation("TeacherClasses")
  memberships Membership[]
  checkIns    CheckIn[]
}

model Class {
  id        String @id @default(cuid())
  name      String
  code      String @unique
  teacherId String
  threshold Int    @default(70) // exam eligibility % for this class
  teacher   User   @relation("TeacherClasses", fields: [teacherId], references: [id])

  memberships Membership[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([classId, studentId])
}

model Session {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  status      String   @default("ACTIVE") // ACTIVE | CLOSED
  secret      String // HMAC secret for rotating QR/PIN
  lat         Float?
  lng         Float?
  radiusM     Int      @default(100)
  requireGps  Boolean  @default(true)
  requireCode Boolean  @default(true) // rotating QR/PIN required for check-in
  durationSec Int      @default(120)
  startedAt   DateTime @default(now())
  endsAt      DateTime
  checkIns    CheckIn[]
}

model CheckIn {
  id          String   @id @default(cuid())
  sessionId   String
  studentId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  student     User     @relation(fields: [studentId], references: [id])
  status      String   @default("PRESENT") // PRESENT | FLAGGED | ABSENT
  distanceM   Float?
  method      String   @default("BUTTON") // QR | PIN | BUTTON | MANUAL
  bioVerified Boolean  @default(false)
  gpsOk       Boolean  @default(false)
  deviceId    String?
  flags       String? // JSON string array of reasons
  createdAt   DateTime @default(now())

  @@unique([sessionId, studentId])
}
